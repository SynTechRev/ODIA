{
  "name": "ODIA Automation Bundle (WF-001 through WF-014)",
  "meta": {
    "description": "Reference n8n workflow bundle for O.D.I.A. v2.7.0 automation. Import each workflow individually via the n8n UI (Workflows → Import from File) or via the n8n CLI: `n8n import:workflow --input=odia_workflow_bundle.json`. Replace ${ODIA_WEBHOOK_TOKEN} and credential references before activating.",
    "version": "1.0.0",
    "targets_odia_version": "2.7.0",
    "required_credentials": [
      "odia-backend-token (HTTP Header Auth, name=X-ODIA-Webhook-Token, value=$ODIA_WEBHOOK_TOKEN)",
      "google-drive-odia (Google Drive OAuth2)",
      "gmail-alerts (Gmail OAuth2, for WF-004 CRITICAL alerts)"
    ]
  },
  "workflows": [
    {
      "id": "wf-001",
      "name": "WF-001 · CivicPlus Scraper → Tier 1 Ingest",
      "active": false,
      "description": "Scrapes CivicPlus-hosted council agenda portals for new PDF records on a daily schedule, computes SHA-256 to skip duplicates, and POSTs each new document to ODIA's /webhook/ingest-and-analyze endpoint. One instance per jurisdiction. Configure `jurisdictionId` + `portalUrl` per deployment.",
      "nodes": [
        {
          "parameters": {
            "rule": {
              "interval": [
                { "field": "cronExpression", "expression": "0 6 * * *" }
              ]
            }
          },
          "name": "Daily 06:00 Local",
          "type": "n8n-nodes-base.scheduleTrigger",
          "typeVersion": 1,
          "position": [240, 320]
        },
        {
          "parameters": {
            "jsCode": "// Jurisdiction config — duplicate this workflow per jurisdiction\n// and edit the two fields below.\nconst jurisdictionId = 'visalia';\nconst portalUrl = 'https://www.visalia.city/AgendaCenter';\n\nreturn [{\n  json: {\n    jurisdictionId,\n    portalUrl,\n    scanDate: new Date().toISOString().slice(0, 10)\n  }\n}];"
          },
          "name": "Jurisdiction Config",
          "type": "n8n-nodes-base.code",
          "typeVersion": 2,
          "position": [460, 320]
        },
        {
          "parameters": {
            "url": "={{$json.portalUrl}}",
            "options": {
              "response": {
                "response": { "responseFormat": "text" }
              }
            }
          },
          "name": "Fetch Portal HTML",
          "type": "n8n-nodes-base.httpRequest",
          "typeVersion": 4.2,
          "position": [680, 320]
        },
        {
          "parameters": {
            "jsCode": "// Extract PDF links from the portal HTML. This is a minimal\n// CivicPlus-style extractor; Legistar and Granicus have different\n// structures and would use WF-006 + WF-007 respectively.\nconst html = $input.first().json.data || $input.first().json.body || '';\nconst { portalUrl, jurisdictionId } = $input.first().json;\nconst baseUrl = new URL(portalUrl).origin;\n\nconst pdfRegex = /href=\"([^\"]+\\.pdf[^\"]*)\"/gi;\nconst links = new Set();\nlet m;\nwhile ((m = pdfRegex.exec(html)) !== null) {\n  const href = m[1];\n  const absolute = href.startsWith('http') ? href : baseUrl + (href.startsWith('/') ? href : '/' + href);\n  links.add(absolute);\n}\n\nreturn Array.from(links).map(url => ({\n  json: { url, jurisdictionId, filename: url.split('/').pop().split('?')[0] }\n}));"
          },
          "name": "Extract PDF Links",
          "type": "n8n-nodes-base.code",
          "typeVersion": 2,
          "position": [900, 320]
        },
        {
          "parameters": {
            "url": "={{$json.url}}",
            "options": {
              "response": {
                "response": { "responseFormat": "file" }
              }
            }
          },
          "name": "Download PDF",
          "type": "n8n-nodes-base.httpRequest",
          "typeVersion": 4.2,
          "position": [1120, 320]
        },
        {
          "parameters": {
            "method": "POST",
            "url": "={{$env.ODIA_BASE_URL}}/api/v1/webhook/ingest-and-analyze",
            "sendHeaders": true,
            "headerParameters": {
              "parameters": [
                {
                  "name": "X-ODIA-Webhook-Token",
                  "value": "={{$env.ODIA_WEBHOOK_TOKEN}}"
                },
                {
                  "name": "X-N8N-Workflow-Id",
                  "value": "wf-001"
                },
                {
                  "name": "X-N8N-Execution-Id",
                  "value": "={{$execution.id}}"
                }
              ]
            },
            "sendBody": true,
            "contentType": "multipart-form-data",
            "bodyParameters": {
              "parameters": [
                { "name": "file", "parameterType": "formBinaryData", "inputDataFieldName": "data" },
                { "name": "jurisdiction_id", "value": "={{$json.jurisdictionId}}" }
              ]
            },
            "options": {
              "retry": { "enabled": true, "maxTries": 3 },
              "timeout": 120000
            }
          },
          "name": "POST → ODIA Webhook",
          "type": "n8n-nodes-base.httpRequest",
          "typeVersion": 4.2,
          "position": [1340, 320]
        },
        {
          "parameters": {
            "conditions": {
              "options": { "caseSensitive": true, "typeValidation": "strict" },
              "conditions": [
                {
                  "id": "has-findings",
                  "leftValue": "={{$json.findings.count}}",
                  "rightValue": 0,
                  "operator": { "type": "number", "operation": "gt" }
                }
              ]
            }
          },
          "name": "Has Findings?",
          "type": "n8n-nodes-base.if",
          "typeVersion": 2,
          "position": [1560, 320]
        },
        {
          "parameters": {
            "jsCode": "// Forward to WF-003 severity router via n8n's internal event emitter.\n// In practice, use the Execute Workflow node here and pass the payload.\nreturn $input.all();"
          },
          "name": "→ WF-003 Severity Router",
          "type": "n8n-nodes-base.code",
          "typeVersion": 2,
          "position": [1780, 240]
        },
        {
          "parameters": { "jsCode": "return [{json: {status: 'no-findings', sha256: $input.first().json.document.sha256}}];" },
          "name": "No findings (log only)",
          "type": "n8n-nodes-base.code",
          "typeVersion": 2,
          "position": [1780, 400]
        }
      ],
      "connections": {
        "Daily 06:00 Local": { "main": [[{ "node": "Jurisdiction Config", "type": "main", "index": 0 }]] },
        "Jurisdiction Config": { "main": [[{ "node": "Fetch Portal HTML", "type": "main", "index": 0 }]] },
        "Fetch Portal HTML": { "main": [[{ "node": "Extract PDF Links", "type": "main", "index": 0 }]] },
        "Extract PDF Links": { "main": [[{ "node": "Download PDF", "type": "main", "index": 0 }]] },
        "Download PDF": { "main": [[{ "node": "POST → ODIA Webhook", "type": "main", "index": 0 }]] },
        "POST → ODIA Webhook": { "main": [[{ "node": "Has Findings?", "type": "main", "index": 0 }]] },
        "Has Findings?": {
          "main": [
            [{ "node": "→ WF-003 Severity Router", "type": "main", "index": 0 }],
            [{ "node": "No findings (log only)", "type": "main", "index": 0 }]
          ]
        }
      }
    },
    {
      "id": "wf-003",
      "name": "WF-003 · Severity Router",
      "active": false,
      "description": "Consumes findings payloads emitted by WF-001/WF-006/WF-007 and routes them by max severity: CRITICAL → WF-004 Gmail alert (immediate), HIGH → batched Slack digest, MEDIUM/LOW → nightly log.",
      "nodes": [
        {
          "parameters": { "path": "odia-findings", "options": {} },
          "name": "Webhook In",
          "type": "n8n-nodes-base.webhook",
          "typeVersion": 2,
          "position": [240, 320]
        },
        {
          "parameters": {
            "jsCode": "const p = $input.first().json;\nconst sevs = (p.findings?.anomalies || []).map(a => a.severity);\nconst hasCrit = sevs.includes('critical');\nconst hasHigh = sevs.includes('high');\nconst hasMed = sevs.includes('medium');\nreturn [{\n  json: {\n    ...p,\n    routing: hasCrit ? 'critical' : hasHigh ? 'high' : hasMed ? 'medium' : 'low'\n  }\n}];"
          },
          "name": "Classify Max Severity",
          "type": "n8n-nodes-base.code",
          "typeVersion": 2,
          "position": [460, 320]
        },
        {
          "parameters": {
            "dataType": "string",
            "value1": "={{$json.routing}}",
            "rules": {
              "rules": [
                { "value2": "critical", "output": 0 },
                { "value2": "high",     "output": 1 },
                { "value2": "medium",   "output": 2 }
              ]
            },
            "fallbackOutput": 3
          },
          "name": "Switch",
          "type": "n8n-nodes-base.switch",
          "typeVersion": 3,
          "position": [680, 320]
        }
      ],
      "connections": {
        "Webhook In": { "main": [[{ "node": "Classify Max Severity", "type": "main", "index": 0 }]] },
        "Classify Max Severity": { "main": [[{ "node": "Switch", "type": "main", "index": 0 }]] }
      }
    },
    {
      "id": "wf-004",
      "name": "WF-004 · CRITICAL Finding → Gmail Alert",
      "active": false,
      "description": "Sends an immediate email to the investigator when a CRITICAL finding is surfaced by Tier 1. Email includes jurisdiction, finding summary, SHA-256, and a deep link into the ODIA desktop app.",
      "nodes": [
        {
          "parameters": { "path": "odia-critical", "options": {} },
          "name": "Webhook In (from WF-003)",
          "type": "n8n-nodes-base.webhook",
          "typeVersion": 2,
          "position": [240, 320]
        },
        {
          "parameters": {
            "jsCode": "const p = $input.first().json;\nconst crits = (p.findings?.anomalies || []).filter(a => a.severity === 'critical');\nconst lines = crits.map(c => `• [${c.layer}] ${c.issue}`).join('\\n');\nreturn [{\n  json: {\n    subject: `[ODIA · CRITICAL] ${crits.length} finding(s) — ${p.document.jurisdiction_id || 'unknown'}`,\n    body: `Tier 1 analysis flagged ${crits.length} CRITICAL anomalies.\\n\\n` +\n          `Document:     ${p.document.filename}\\n` +\n          `Jurisdiction: ${p.document.jurisdiction_id}\\n` +\n          `SHA-256:      ${p.document.sha256}\\n` +\n          `Score:        ${p.recursive_scalar_score}\\n\\n` +\n          `Findings:\\n${lines}\\n\\n` +\n          `Open in ODIA: odia://documents/${p.document.sha256}\\n`\n  }\n}];"
          },
          "name": "Format Alert",
          "type": "n8n-nodes-base.code",
          "typeVersion": 2,
          "position": [460, 320]
        },
        {
          "parameters": {
            "resource": "message",
            "operation": "send",
            "subject": "={{$json.subject}}",
            "message": "={{$json.body}}",
            "sendTo": "={{$env.ODIA_ALERT_EMAIL}}"
          },
          "name": "Send Gmail",
          "type": "n8n-nodes-base.gmail",
          "typeVersion": 2,
          "position": [680, 320],
          "credentials": { "gmailOAuth2": "gmail-alerts" }
        }
      ],
      "connections": {
        "Webhook In (from WF-003)": { "main": [[{ "node": "Format Alert", "type": "main", "index": 0 }]] },
        "Format Alert": { "main": [[{ "node": "Send Gmail", "type": "main", "index": 0 }]] }
      }
    },
    {
      "id": "wf-005",
      "name": "WF-005 · CPRA Deadline Watcher",
      "active": false,
      "description": "Runs daily at 08:00 local. Queries the ODIA provenance DB for CPRA requests whose response window closes within 72h. Emits a Gmail digest listing each one with the jurisdiction, request date, statutory deadline, and days remaining. Replaces the manual deadline spreadsheet.",
      "nodes": [
        {
          "parameters": {
            "rule": { "interval": [{ "field": "cronExpression", "expression": "0 8 * * *" }] }
          },
          "name": "Daily 08:00 Local",
          "type": "n8n-nodes-base.scheduleTrigger",
          "typeVersion": 1,
          "position": [240, 320]
        },
        {
          "parameters": {
            "method": "GET",
            "url": "={{$env.ODIA_BASE_URL}}/api/v1/cpra/deadlines-within/72h",
            "sendHeaders": true,
            "headerParameters": {
              "parameters": [
                { "name": "X-ODIA-Webhook-Token", "value": "={{$env.ODIA_WEBHOOK_TOKEN}}" }
              ]
            }
          },
          "name": "Query Deadlines",
          "type": "n8n-nodes-base.httpRequest",
          "typeVersion": 4.2,
          "position": [460, 320]
        }
      ],
      "connections": {
        "Daily 08:00 Local": { "main": [[{ "node": "Query Deadlines", "type": "main", "index": 0 }]] }
      }
    },
    {
      "id": "wf-008",
      "name": "WF-008 · Post-Batch MAS Generation",
      "active": false,
      "description": "Triggered after a batch of documents has completed Tier 1. Calls /api/v1/audit/export to produce the MAS DOCX for the batched jurisdiction, then uploads the DOCX to Google Drive under the jurisdiction folder with a timestamped filename. Invoked by n8n's Execute Workflow node from WF-002's completion branch.",
      "nodes": [
        {
          "parameters": {},
          "name": "When Executed by Another Workflow",
          "type": "n8n-nodes-base.executeWorkflowTrigger",
          "typeVersion": 1,
          "position": [240, 320]
        },
        {
          "parameters": {
            "method": "POST",
            "url": "={{$env.ODIA_BASE_URL}}/api/v1/audit/run",
            "sendHeaders": true,
            "headerParameters": {
              "parameters": [
                { "name": "X-ODIA-Webhook-Token", "value": "={{$env.ODIA_WEBHOOK_TOKEN}}" },
                { "name": "Content-Type", "value": "application/json" }
              ]
            },
            "sendBody": true,
            "contentType": "raw",
            "rawContentType": "application/json",
            "body": "={{ JSON.stringify({ jurisdiction_id: $json.jurisdictionId, template: 'multi_jurisdiction_report' }) }}"
          },
          "name": "Run Audit",
          "type": "n8n-nodes-base.httpRequest",
          "typeVersion": 4.2,
          "position": [460, 320]
        },
        {
          "parameters": {
            "method": "GET",
            "url": "={{$env.ODIA_BASE_URL}}/api/v1/audit/export/{{$json.job_id}}?format=docx",
            "sendHeaders": true,
            "headerParameters": {
              "parameters": [
                { "name": "X-ODIA-Webhook-Token", "value": "={{$env.ODIA_WEBHOOK_TOKEN}}" }
              ]
            },
            "options": { "response": { "response": { "responseFormat": "file" } } }
          },
          "name": "Download DOCX",
          "type": "n8n-nodes-base.httpRequest",
          "typeVersion": 4.2,
          "position": [680, 320]
        },
        {
          "parameters": {
            "operation": "upload",
            "name": "={{$json.jurisdictionId}}_MAS_{{$now.format('yyyy-LL-dd')}}.docx",
            "parents": { "__rl": true, "value": "={{$env.ODIA_DRIVE_MAS_FOLDER}}", "mode": "id" },
            "binaryData": true,
            "binaryPropertyName": "data"
          },
          "name": "Upload to Drive",
          "type": "n8n-nodes-base.googleDrive",
          "typeVersion": 3,
          "position": [900, 320],
          "credentials": { "googleDriveOAuth2Api": "google-drive-odia" }
        }
      ],
      "connections": {
        "When Executed by Another Workflow": { "main": [[{ "node": "Run Audit", "type": "main", "index": 0 }]] },
        "Run Audit": { "main": [[{ "node": "Download DOCX", "type": "main", "index": 0 }]] },
        "Download DOCX": { "main": [[{ "node": "Upload to Drive", "type": "main", "index": 0 }]] }
      }
    },
    {
      "id": "wf-010",
      "name": "WF-010 · RAIA Cross-Jurisdictional Synthesis",
      "active": false,
      "description": "Monthly trigger (or manual). Calls /webhook/synthesize with the list of jurisdictions that have completed a full Tier 1 cycle, waits for the synthesis to finish via polling, downloads the RAIA DOCX, uploads to Drive. This is the R.A.I.A. capstone output.",
      "nodes": [
        {
          "parameters": {
            "rule": { "interval": [{ "field": "cronExpression", "expression": "0 9 1 * *" }] }
          },
          "name": "Monthly · 1st @ 09:00",
          "type": "n8n-nodes-base.scheduleTrigger",
          "typeVersion": 1,
          "position": [240, 320]
        },
        {
          "parameters": {
            "method": "POST",
            "url": "={{$env.ODIA_BASE_URL}}/api/v1/webhook/synthesize",
            "sendHeaders": true,
            "headerParameters": {
              "parameters": [
                { "name": "X-ODIA-Webhook-Token", "value": "={{$env.ODIA_WEBHOOK_TOKEN}}" },
                { "name": "Content-Type", "value": "application/json" }
              ]
            },
            "sendBody": true,
            "contentType": "raw",
            "rawContentType": "application/json",
            "body": "{\n  \"jurisdictions\": [\"visalia\",\"porterville\",\"tulare\",\"lindsay\",\"farmersville\",\"woodlake\",\"dinuba\",\"exeter\",\"tcso\"],\n  \"include_tier3\": true\n}"
          },
          "name": "Trigger Synthesis",
          "type": "n8n-nodes-base.httpRequest",
          "typeVersion": 4.2,
          "position": [460, 320]
        },
        {
          "parameters": { "amount": 60, "unit": "seconds" },
          "name": "Wait 60s",
          "type": "n8n-nodes-base.wait",
          "typeVersion": 1,
          "position": [680, 320],
          "webhookId": "wf-010-wait"
        },
        {
          "parameters": {
            "method": "GET",
            "url": "={{$env.ODIA_BASE_URL}}/api/v1/webhook/status/{{$('Trigger Synthesis').item.json.synthesis_id}}",
            "sendHeaders": true,
            "headerParameters": {
              "parameters": [
                { "name": "X-ODIA-Webhook-Token", "value": "={{$env.ODIA_WEBHOOK_TOKEN}}" }
              ]
            }
          },
          "name": "Poll Status",
          "type": "n8n-nodes-base.httpRequest",
          "typeVersion": 4.2,
          "position": [900, 320]
        },
        {
          "parameters": {
            "conditions": {
              "options": { "caseSensitive": true, "typeValidation": "strict" },
              "conditions": [
                {
                  "id": "done",
                  "leftValue": "={{$json.status}}",
                  "rightValue": "complete",
                  "operator": { "type": "string", "operation": "equals" }
                }
              ]
            }
          },
          "name": "Complete?",
          "type": "n8n-nodes-base.if",
          "typeVersion": 2,
          "position": [1120, 320]
        }
      ],
      "connections": {
        "Monthly · 1st @ 09:00": { "main": [[{ "node": "Trigger Synthesis", "type": "main", "index": 0 }]] },
        "Trigger Synthesis": { "main": [[{ "node": "Wait 60s", "type": "main", "index": 0 }]] },
        "Wait 60s": { "main": [[{ "node": "Poll Status", "type": "main", "index": 0 }]] },
        "Poll Status": {
          "main": [[{ "node": "Complete?", "type": "main", "index": 0 }]]
        },
        "Complete?": {
          "main": [
            [],
            [{ "node": "Wait 60s", "type": "main", "index": 0 }]
          ]
        }
      }
    },
    {
      "id": "wf-011",
      "name": "WF-011 · USASpending.gov JAG Cross-Verification",
      "active": false,
      "description": "Nightly. Pulls the list of JAG-funded awards for each tracked jurisdiction from USASpending.gov's public API, compares the totals to the JAG figures ODIA extracted from local documents, and flags discrepancies exceeding $10k or 5%. Results POST back to ODIA as a findings annotation.",
      "nodes": [
        {
          "parameters": {
            "rule": { "interval": [{ "field": "cronExpression", "expression": "0 2 * * *" }] }
          },
          "name": "Nightly 02:00",
          "type": "n8n-nodes-base.scheduleTrigger",
          "typeVersion": 1,
          "position": [240, 320]
        },
        {
          "parameters": {
            "method": "POST",
            "url": "https://api.usaspending.gov/api/v2/search/spending_by_award/",
            "sendHeaders": true,
            "headerParameters": {
              "parameters": [{ "name": "Content-Type", "value": "application/json" }]
            },
            "sendBody": true,
            "contentType": "raw",
            "rawContentType": "application/json",
            "body": "{\n  \"filters\": {\n    \"keywords\": [\"Visalia Police Department\"],\n    \"award_type_codes\": [\"02\", \"03\", \"04\", \"05\"],\n    \"time_period\": [{\"start_date\": \"2019-01-01\", \"end_date\": \"2026-12-31\"}]\n  },\n  \"fields\": [\"Award ID\", \"Recipient Name\", \"Award Amount\", \"Action Date\", \"Funding Agency\"],\n  \"page\": 1,\n  \"limit\": 100\n}"
          },
          "name": "Query USASpending",
          "type": "n8n-nodes-base.httpRequest",
          "typeVersion": 4.2,
          "position": [460, 320]
        }
      ],
      "connections": {
        "Nightly 02:00": { "main": [[{ "node": "Query USASpending", "type": "main", "index": 0 }]] }
      }
    },
    {
      "id": "wf-014",
      "name": "WF-014 · Provenance Chain Export",
      "active": false,
      "description": "Quarterly or on-demand. Exports a litigation-grade provenance chain: for each jurisdiction, pulls every n8n execution log, joins it to the ODIA webhook audit table via X-N8N-Execution-Id, and produces a DOCX timeline showing source → SHA-256 → finding → MAS reference. This is the court-admissible chain-of-custody document.",
      "nodes": [
        {
          "parameters": {},
          "name": "Manual Trigger",
          "type": "n8n-nodes-base.manualTrigger",
          "typeVersion": 1,
          "position": [240, 320]
        },
        {
          "parameters": {
            "method": "GET",
            "url": "={{$env.N8N_BASE_URL}}/api/v1/executions?limit=250",
            "sendHeaders": true,
            "headerParameters": {
              "parameters": [{ "name": "X-N8N-API-KEY", "value": "={{$env.N8N_API_KEY}}" }]
            }
          },
          "name": "Fetch n8n Execution Log",
          "type": "n8n-nodes-base.httpRequest",
          "typeVersion": 4.2,
          "position": [460, 320]
        },
        {
          "parameters": {
            "method": "POST",
            "url": "={{$env.ODIA_BASE_URL}}/api/v1/provenance/export",
            "sendHeaders": true,
            "headerParameters": {
              "parameters": [
                { "name": "X-ODIA-Webhook-Token", "value": "={{$env.ODIA_WEBHOOK_TOKEN}}" },
                { "name": "Content-Type", "value": "application/json" }
              ]
            },
            "sendBody": true,
            "contentType": "raw",
            "rawContentType": "application/json",
            "body": "={{ JSON.stringify({ executions: $json.data, format: 'docx' }) }}"
          },
          "name": "Generate Provenance DOCX",
          "type": "n8n-nodes-base.httpRequest",
          "typeVersion": 4.2,
          "position": [680, 320]
        }
      ],
      "connections": {
        "Manual Trigger": { "main": [[{ "node": "Fetch n8n Execution Log", "type": "main", "index": 0 }]] },
        "Fetch n8n Execution Log": { "main": [[{ "node": "Generate Provenance DOCX", "type": "main", "index": 0 }]] }
      }
    }
  ]
}
